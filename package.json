{
  "name": "camexplorer",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "check": "npm run typecheck && npm run lint && npm test -- --ci",
    "fake-nvr": "docker compose -f docker/fake-nvr/compose.yml up -d",
    "fake-nvr:stop": "docker compose -f docker/fake-nvr/compose.yml down",
    "build:apk": "node scripts/build-apk.mjs release",
    "build:apk:debug": "node scripts/build-apk.mjs debug arm64-v8a",
    "install:device": "node scripts/install-device.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "0.1.7",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/docker/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "moduleNameMapper": {
      "^rtsp-player$": "<rootDir>/modules/rtsp-player",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "license": "MIT"
}
