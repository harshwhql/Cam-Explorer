<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Background motion watch (MotionPopupService). Off unless enabled in Settings. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Lets the app come forward on motion; must still be granted by the user. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application>
    <service
      android:name="expo.modules.rtspplayer.MotionPopupService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Watches the user's own CCTV recorder on the local network for motion" />
    </service>
  </application>
</manifest>
